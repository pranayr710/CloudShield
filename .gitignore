# --- Data -------------------------------------------------------------------
# The raw captures are multi-GB and must never be committed. The download
# scripts in data/ fetch them; those scripts ARE tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*/
data/processed/*/*
!data/processed/*/.gitkeep

# NOTE: do not use a blanket "data/*" rule - it would also ignore the
# download scripts, which the repository must contain.

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Models -----------------------------------------------------------------
# Fitted estimators can be large and are regenerated by the notebooks.
models/**/*.joblib
models/**/*.pkl

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Archives ---------------------------------------------------------------
*.rar
*.zip

# local working copies, not part of the repository
ML/
ml_own/
